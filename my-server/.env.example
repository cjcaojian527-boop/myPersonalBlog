# ==================== 使用方式 ====================
# 本地开发：复制为 .env
# Docker 部署：复制为 .env.docker
# 所有 change_me 都必须换成真实值，切勿提交真实密钥！

# ==================== 服务 ====================
PORT=3002
NODE_ENV=development

# ==================== MySQL ====================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=adminDBsystem
DB_USER=root
DB_PASSWORD=change_me

# ==================== JWT ====================
# 用随机长字符串，不要用有意义的单词
JWT_SECRET=change_me_to_a_long_random_string
JWT_TOURISTS_SECRET=change_me_to_another_long_random_string
JWT_EXPIRES_IN=7d
JWT_TEMP_EXPIRES_IN=1d

# ==================== SM2 国密（登录密码加密） ====================
# 前后端必须使用同一对密钥；cipherMode 固定为 1（C1C3C2）
SM2_PRIVATE_KEY=change_me
SM2_PUBLIC_KEY=change_me

# ==================== MinIO 对象存储 ====================
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=blog

# ==================== 默认密码 ====================
defaultPassword=change_me
